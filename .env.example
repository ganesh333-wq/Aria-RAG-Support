# ── Aria — Environment Configuration ─────────────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API (LLM Provider) ───────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for query rewriting and response generation
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL="llama-3.3-70b-versatile"

# ── Knowledge Base ────────────────────────────────────────────────────────────
KB_PATH="knowledge/knowledge_base.json"

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
# Path where ChromaDB persists embeddings on disk
CHROMA_PERSIST_DIR="./chroma_db"

# ChromaDB collection name
CHROMA_COLLECTION="aria_faq"

# ── RAG Pipeline Settings ─────────────────────────────────────────────────────
# Minimum cosine similarity score to accept a retrieved document (0-1)
# Below this threshold → NO_MATCH response (avoids hallucination)
MIN_ANSWER_CONFIDENCE=0.55

# Number of top documents to retrieve
TOP_K_RETRIEVAL=5

# ── Session Settings ──────────────────────────────────────────────────────────
# Session timeout in seconds (default: 30 minutes)
SESSION_TIMEOUT_SECONDS=1800
